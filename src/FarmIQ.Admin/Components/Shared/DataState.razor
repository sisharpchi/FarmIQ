@inject AdminLocalizer Localizer

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}
else if (IsLoading)
{
    <p class="loading-copy">@(string.IsNullOrWhiteSpace(LoadingText) ? Localizer["Loading..."] : LoadingText)</p>
}
else if (IsEmpty)
{
    <div class="empty-state">@(string.IsNullOrWhiteSpace(EmptyText) ? Localizer["Nothing to show."] : EmptyText)</div>
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? LoadingText { get; set; }
    [Parameter] public string? EmptyText { get; set; }
}
