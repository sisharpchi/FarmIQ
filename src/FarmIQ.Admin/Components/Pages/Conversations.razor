@page "/conversations"
@attribute [RouteAccess]
@inject FarmAdminApiClient ApiClient

<PageTitle>Conversations | FarmIQ Admin</PageTitle>

<h1>Conversations</h1>

<div class="page-grid">
    <section class="panel-card">
        <div class="table-tools">
            <button class="btn btn-outline-success" @onclick="LoadAsync">Refresh</button>
        </div>

        <DataState IsLoading="@_isLoading" IsEmpty="@(_response is not null && _response.Items.Count == 0)" Error="@_error" LoadingText="Loading conversations..." EmptyText="No farmer conversations are available yet." />

        @if (_response is not null && string.IsNullOrWhiteSpace(_error))
        {
            <table class="table table-darkless">
                <thead>
                    <tr>
                        <th>Farmer</th>
                        <th>Channel</th>
                        <th>Intent</th>
                        <th>State</th>
                        <th>Location</th>
                        <th>Inbound</th>
                        <th>Outbound</th>
                        <th>Last message</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _response.Items)
                    {
                        <tr>
                            <td>@item.FarmerName</td>
                            <td>@item.ChannelType</td>
                            <td>@item.LastDetectedIntent</td>
                            <td>@item.AssistantState</td>
                            <td>@(item.LocationKnown ? "Saved" : "Missing")</td>
                            <td>@item.InboundCount</td>
                            <td>@item.OutboundCount</td>
                            <td>@item.LastMessageUtc.ToLocalTime().ToString("g")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SelectConversationAsync(item.ConversationId)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <PaginationBar Page="@_page" PageSize="@_pageSize" TotalCount="@_response.TotalCount" OnPageChanged="HandlePageChangedAsync" />
        }
    </section>

    <section class="panel-card">
        <h2>Conversation detail</h2>

        @if (!string.IsNullOrWhiteSpace(_detailError))
        {
            <div class="alert alert-danger">@_detailError</div>
        }
        else if (_detail is null)
        {
            <p>Select a conversation to inspect the message timeline.</p>
        }
        else
        {
            <div class="detail-meta">
                <strong>@_detail.FarmerName</strong>
                <span>@_detail.ChannelType | @_detail.LastMessageUtc.ToLocalTime().ToString("g")</span>
            </div>

            <ul class="signal-list">
                <li>Assistant state: @_detail.AssistantState</li>
                <li>Last detected intent: @_detail.LastDetectedIntent</li>
                <li>Location known: @(_detail.LocationKnown ? "Yes" : "No")</li>
                <li>Last bot prompt: @(_detail.LastBotPromptUtc?.ToLocalTime().ToString("g") ?? "Not yet")</li>
                <li>Location requested: @(_detail.LocationRequestedUtc?.ToLocalTime().ToString("g") ?? "No")</li>
            </ul>

            <div class="timeline">
                @foreach (var message in _detail.Messages)
                {
                    <div class="timeline-item">
                        <div class="timeline-head">
                            <span>@message.Direction</span>
                            <span>@message.CreatedUtc.ToLocalTime().ToString("g")</span>
                        </div>
                        @if (message.IntentType.HasValue)
                        {
                            <div class="subtle-copy">Intent: @message.IntentType</div>
                        }
                        <div>@(string.IsNullOrWhiteSpace(message.Text) ? "No text payload was captured for this event." : message.Text)</div>
                        @if (!string.IsNullOrWhiteSpace(message.IgnoredReason))
                        {
                            <div class="subtle-copy">Ignored reason: @message.IgnoredReason</div>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private PagedResponseModel<ConversationSummaryModel>? _response;
    private ConversationDetailModel? _detail;
    private string? _error;
    private string? _detailError;
    private bool _isLoading = true;
    private int _page = 1;
    private const int _pageSize = 12;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _error = null;
            _response = await ApiClient.GetConversationsAsync(_page, _pageSize);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectConversationAsync(Guid id)
    {
        try
        {
            _detailError = null;
            _detail = await ApiClient.GetConversationDetailAsync(id);
        }
        catch (Exception exception)
        {
            _detailError = exception.Message;
        }
    }

    private async Task HandlePageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }
}
