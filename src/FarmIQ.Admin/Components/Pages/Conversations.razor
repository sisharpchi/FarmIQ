@page "/conversations"
@attribute [RouteAccess]
@inject FarmAdminApiClient ApiClient
@inject AdminLocalizer Localizer

<PageTitle>@(Localizer["Conversations"] + " | FarmIQ Admin")</PageTitle>

<h1>@Localizer["Conversations"]</h1>

<div class="page-grid">
    <section class="panel-card">
        <div class="table-tools">
            <button class="btn btn-outline-success" @onclick="LoadAsync">@Localizer["Refresh"]</button>
        </div>

        <DataState IsLoading="@_isLoading" IsEmpty="@(_response is not null && _response.Items.Count == 0)" Error="@_error" LoadingText="@(Localizer["Loading conversations..."])" EmptyText="@(Localizer["No farmer conversations are available yet."])" />

        @if (_response is not null && string.IsNullOrWhiteSpace(_error))
        {
            <table class="table table-darkless">
                <thead>
                    <tr>
                        <th>Farmer</th>
                        <th>@Localizer["Channel"]</th>
                        <th>Intent</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Location"]</th>
                        <th>Inbound</th>
                        <th>Outbound</th>
                        <th>@Localizer["Last message"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _response.Items)
                    {
                        <tr>
                            <td>@item.FarmerName</td>
                            <td>@Localizer.Channel(item.ChannelType)</td>
                            <td>@Localizer.Intent(item.LastDetectedIntent)</td>
                            <td>@Localizer.AssistantState(item.AssistantState)</td>
                            <td>@(item.LocationKnown ? Localizer["Saved"] : Localizer["Missing"])</td>
                            <td>@item.InboundCount</td>
                            <td>@item.OutboundCount</td>
                            <td>@Localizer.FormatDateTime(item.LastMessageUtc.ToLocalTime())</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SelectConversationAsync(item.ConversationId)">
                                    @Localizer["View"]
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <PaginationBar Page="@_page" PageSize="@_pageSize" TotalCount="@_response.TotalCount" OnPageChanged="HandlePageChangedAsync" />
        }
    </section>

    <section class="panel-card">
        <h2>@Localizer["Conversation detail"]</h2>

        @if (!string.IsNullOrWhiteSpace(_detailError))
        {
            <div class="alert alert-danger">@_detailError</div>
        }
        else if (_detail is null)
        {
            <p>@Localizer["Select a conversation to inspect the message timeline."]</p>
        }
        else
        {
            <div class="detail-meta">
                <strong>@_detail.FarmerName</strong>
                <span>@Localizer.Channel(_detail.ChannelType) | @Localizer.FormatDateTime(_detail.LastMessageUtc.ToLocalTime())</span>
            </div>

            <ul class="signal-list">
                <li>@DetailLine("Assistant state", Localizer.AssistantState(_detail.AssistantState))</li>
                <li>@DetailLine("Last detected intent", Localizer.Intent(_detail.LastDetectedIntent))</li>
                <li>@DetailLine("Location known", Localizer.Bool(_detail.LocationKnown))</li>
                <li>@DetailLine("Last bot prompt", Localizer.FormatNullableDateTime(_detail.LastBotPromptUtc?.ToLocalTime(), "Not available"))</li>
                <li>@DetailLine("Location requested", Localizer.FormatNullableDateTime(_detail.LocationRequestedUtc?.ToLocalTime(), "No"))</li>
            </ul>

            <div class="timeline">
                @foreach (var message in _detail.Messages)
                {
                    <div class="timeline-item">
                        <div class="timeline-head">
                            <span>@Localizer.Direction(message.Direction)</span>
                            <span>@Localizer.FormatDateTime(message.CreatedUtc.ToLocalTime())</span>
                        </div>
                        @if (message.IntentType.HasValue)
                        {
                            <div class="subtle-copy">@DetailLine("Intent", Localizer.Intent(message.IntentType))</div>
                        }
                        <div>@(string.IsNullOrWhiteSpace(message.Text) ? Localizer["No text payload was captured for this event."] : message.Text)</div>
                        @if (!string.IsNullOrWhiteSpace(message.IgnoredReason))
                        {
                            <div class="subtle-copy">@DetailLine("Ignored reason", message.IgnoredReason)</div>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private PagedResponseModel<ConversationSummaryModel>? _response;
    private ConversationDetailModel? _detail;
    private string? _error;
    private string? _detailError;
    private bool _isLoading = true;
    private int _page = 1;
    private const int _pageSize = 12;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _error = null;
            _response = await ApiClient.GetConversationsAsync(_page, _pageSize);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectConversationAsync(Guid id)
    {
        try
        {
            _detailError = null;
            _detail = await ApiClient.GetConversationDetailAsync(id);
        }
        catch (Exception exception)
        {
            _detailError = exception.Message;
        }
    }

    private async Task HandlePageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private string DetailLine(string label, string value) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"{TranslateLabel(label)}: {value}",
        FarmLanguages.Uzbek => $"{TranslateLabel(label)}: {value}",
        _ => $"{label}: {value}"
    };

    private string TranslateLabel(string label) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => label switch
        {
            "Assistant state" => "Состояние ассистента",
            "Last detected intent" => "Последний распознанный интент",
            "Location known" => "Локация известна",
            "Last bot prompt" => "Последний бот-запрос",
            "Location requested" => "Когда просили геолокацию",
            "Intent" => "Интент",
            "Ignored reason" => "Причина игнорирования",
            _ => label
        },
        FarmLanguages.Uzbek => label switch
        {
            "Assistant state" => "Assistant holati",
            "Last detected intent" => "Oxirgi aniqlangan intent",
            "Location known" => "Joylashuv ma'lum",
            "Last bot prompt" => "Botning oxirgi prompti",
            "Location requested" => "Joylashuv so'ralgan vaqt",
            "Intent" => "Intent",
            "Ignored reason" => "Ignore sababi",
            _ => label
        },
        _ => label
    };
}
