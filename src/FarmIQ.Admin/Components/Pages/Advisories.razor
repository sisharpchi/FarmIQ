@page "/advisories"
@attribute [RouteAccess]
@inject FarmAdminApiClient ApiClient
@inject AdminLocalizer Localizer

<PageTitle>@(Localizer["Advisories"] + " | FarmIQ Admin")</PageTitle>

<h1>@Localizer["Advisories"]</h1>

<div class="page-grid">
    <section class="panel-card">
        <DataState IsLoading="@_isLoading" IsEmpty="@(_advisories is not null && _advisories.Items.Count == 0)" Error="@_error" LoadingText="@(Localizer["Loading advisories..."])" EmptyText="@(Localizer["No advisories available yet."])" />

        @if (_advisories is not null && string.IsNullOrWhiteSpace(_error))
        {
            <table class="table table-darkless">
                <thead>
                    <tr>
                        <th>@Localizer["Disease"]</th>
                        <th>@Localizer["Confidence"]</th>
                        <th>@Localizer["Source"]</th>
                        <th>@Localizer["Follow-up"]</th>
                        <th>@Localizer["Language"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var advisory in _advisories.Items)
                    {
                        <tr>
                            <td>@advisory.DiseaseName</td>
                            <td>@Localizer.FormatPercent(advisory.ConfidenceScore)</td>
                            <td>@Localizer.AnalysisSource(advisory.AnalysisSource)</td>
                            <td>@Localizer.Bool(advisory.NeedsCloserPhoto || advisory.NeedsLocation)</td>
                            <td>@advisory.AdvisoryLanguage</td>
                            <td><button class="btn btn-sm btn-outline-success" @onclick="() => SelectAdvisoryAsync(advisory.AdvisoryId)">@Localizer["View"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>

            <PaginationBar Page="@_page" PageSize="@_pageSize" TotalCount="@_advisories.TotalCount" OnPageChanged="HandlePageChangedAsync" />
        }
    </section>

    <section class="panel-card">
        <h2>@Localizer["Advisory detail"]</h2>
        @if (_detail is null)
        {
            <p>@Localizer["Select an advisory to view diagnosis, treatment, and weather context."]</p>
        }
        else
        {
            <div class="detail-meta"><strong>@_detail.DiseaseName</strong><span>@ConfidenceLabel(_detail.ConfidenceScore)</span></div>
            <p>@_detail.AdvisoryText</p>
            <ul class="signal-list">
                <li>@DetailLine("Analysis source", Localizer.AnalysisSource(_detail.AnalysisSource))</li>
                <li>@DetailLine("Treatment", _detail.TreatmentRecommendation)</li>
                <li>@DetailLine("Harvest timing", _detail.HarvestTiming)</li>
                <li>@DetailLine("Weather", string.IsNullOrWhiteSpace(_detail.WeatherSummary) ? Localizer["Not available"] : _detail.WeatherSummary)</li>
                <li>@DetailLine("Impact", string.IsNullOrWhiteSpace(_detail.CropImpact) ? Localizer["Not available"] : _detail.CropImpact)</li>
                <li>@DetailLine("Needs closer photo", Localizer.Bool(_detail.NeedsCloserPhoto))</li>
                <li>@DetailLine("Needs location", Localizer.Bool(_detail.NeedsLocation))</li>
                <li>@DetailLine("Follow-up question", _detail.FollowUpQuestion ?? Localizer["None"])</li>
                <li>@DetailLine("Reasoning summary", _detail.ShortReasoningSummary ?? Localizer["None"])</li>
            </ul>
        }
    </section>
</div>

@code {
    private PagedResponseModel<AdvisorySummaryModel>? _advisories;
    private AdvisoryDetailModel? _detail;
    private string? _error;
    private bool _isLoading = true;
    private int _page = 1;
    private const int _pageSize = 12;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _error = null;
            _advisories = await ApiClient.GetAdvisoriesAsync(_page, _pageSize);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectAdvisoryAsync(Guid advisoryId) => _detail = await ApiClient.GetAdvisoryDetailAsync(advisoryId);

    private async Task HandlePageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private string ConfidenceLabel(decimal value) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"Уверенность: {Localizer.FormatPercent(value)}",
        FarmLanguages.Uzbek => $"Ishonchlilik: {Localizer.FormatPercent(value)}",
        _ => $"{Localizer.FormatPercent(value)} confidence"
    };

    private string DetailLine(string label, string value) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"{TranslateLabel(label)}: {value}",
        FarmLanguages.Uzbek => $"{TranslateLabel(label)}: {value}",
        _ => $"{label}: {value}"
    };

    private string TranslateLabel(string label) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => label switch
        {
            "Analysis source" => "Источник анализа",
            "Treatment" => "Рекомендация",
            "Harvest timing" => "Срок сбора",
            "Weather" => "Погода",
            "Impact" => "Влияние",
            "Needs closer photo" => "Нужно более близкое фото",
            "Needs location" => "Нужна геолокация",
            "Follow-up question" => "Уточняющий вопрос",
            "Reasoning summary" => "Краткое объяснение",
            _ => label
        },
        FarmLanguages.Uzbek => label switch
        {
            "Analysis source" => "Tahlil manbasi",
            "Treatment" => "Tavsiya",
            "Harvest timing" => "Hosil muddati",
            "Weather" => "Ob-havo",
            "Impact" => "Ta'sir",
            "Needs closer photo" => "Yaqinroq rasm kerak",
            "Needs location" => "Joylashuv kerak",
            "Follow-up question" => "Qo'shimcha savol",
            "Reasoning summary" => "Qisqa izoh",
            _ => label
        },
        _ => label
    };
}
