@page "/"
@page "/dashboard"
@attribute [RouteAccess]
@implements IDisposable
@inject FarmAdminApiClient ApiClient
@inject RefreshCoordinator RefreshCoordinator
@inject AdminLocalizer Localizer

<PageTitle>@(Localizer["Dashboard"] + " | FarmIQ Admin")</PageTitle>

<h1>@Localizer["Dashboard"]</h1>

<DataState IsLoading="@(_analytics is null || _status is null)" IsEmpty="false" Error="@_error" LoadingText="@(Localizer["Loading dashboard..."])" />

@if (_analytics is not null && _status is not null)
{
    <div class="grid-cards">
        <div class="metric-card"><span>@Localizer["Farmers"]</span><strong>@Localizer.FormatNumber(_analytics.TotalFarmers)</strong></div>
        <div class="metric-card"><span>@Localizer["Conversations"]</span><strong>@Localizer.FormatNumber(_analytics.TotalConversations)</strong></div>
        <div class="metric-card"><span>@Localizer["Failed jobs"]</span><strong>@Localizer.FormatNumber(_analytics.FailedJobs)</strong></div>
        <div class="metric-card"><span>@Localizer["Duplicate deliveries"]</span><strong>@Localizer.FormatNumber(_analytics.DuplicateDeliveries)</strong></div>
        <div class="metric-card"><span>@Localizer["Completed advisories"]</span><strong>@Localizer.FormatNumber(_analytics.CompletedAdvisories)</strong></div>
        <div class="metric-card"><span>@Localizer["Stuck jobs"]</span><strong>@Localizer.FormatNumber(_analytics.StuckJobs)</strong></div>
        <div class="metric-card"><span>@Localizer["Command messages"]</span><strong>@Localizer.FormatNumber(_analytics.CommandMessages)</strong></div>
        <div class="metric-card"><span>@Localizer["Greetings / vague"]</span><strong>@Localizer.FormatNumber(_analytics.GreetingMessages)</strong></div>
        <div class="metric-card"><span>@Localizer["Follow-up advisories"]</span><strong>@Localizer.FormatNumber(_analytics.FollowUpResponses)</strong></div>
        <div class="metric-card"><span>@Localizer["Fallback analyses"]</span><strong>@Localizer.FormatNumber(_analytics.OpenAiFallbacks)</strong></div>
    </div>

    <div class="page-grid">
        <section class="panel-card">
            <h2>@Localizer["System readiness"]</h2>
            <div class="status-grid">
                <div class="@StatusClass(_healthOk)">API: @(_healthOk ? Localizer["Healthy"] : Localizer["Unavailable"])</div>
                <div class="@StatusClass(_status.DatabaseConfigured)">@Localizer["Database"]</div>
                <div class="@StatusClass(_status.StorageConfigured)">@Localizer["Storage"]</div>
                <div class="@StatusClass(_status.WeatherConfigured)">@Localizer["Weather"]</div>
                <div class="@StatusClass(_status.WhatsAppConfigured)">WhatsApp</div>
                <div class="@StatusClass(_status.TelegramConfigured)">Telegram</div>
                <div class="@StatusClass(_status.InstagramConfigured)">Instagram</div>
                <div class="@StatusClass(_status.GlmConfigured)">GLM-5.1</div>
                <div class="@StatusClass(_status.OpenAiConfigured)">OpenAI</div>
            </div>
        </section>

        <section class="panel-card">
            <h2>@Localizer["Current focus"]</h2>
            <ul class="signal-list">
                <li>@FocusFailedJobs()</li>
                <li>@FocusStuckJobs()</li>
                <li>@FocusDuplicateDeliveries()</li>
                <li>@FocusFallbacks()</li>
                <li>@Localizer.Format("Server time: {0}", Localizer.FormatDateTime(_status.ServerUtc.ToLocalTime()))</li>
                @if (_lastUpdatedUtc.HasValue)
                {
                    <li>@Localizer.Format("UI last refreshed: {0}", Localizer.FormatDateTime(_lastUpdatedUtc.Value.ToLocalTime()))</li>
                }
            </ul>
        </section>
    </div>

    @if (_insights is not null)
    {
        <section class="panel-card">
            <h2>@Localizer["B2B insight snapshot"]</h2>
            <div class="grid-cards compact-cards">
                <div class="metric-card"><span>@Localizer["Farmers"]</span><strong>@Localizer.FormatNumber(_insights.TotalFarmers)</strong></div>
                <div class="metric-card"><span>@Localizer["Conversations"]</span><strong>@Localizer.FormatNumber(_insights.TotalConversations)</strong></div>
                <div class="metric-card"><span>@Localizer["Completed advisories"]</span><strong>@Localizer.FormatNumber(_insights.CompletedAdvisories)</strong></div>
                <div class="metric-card"><span>@Localizer["Failed jobs"]</span><strong>@Localizer.FormatNumber(_insights.FailedJobs)</strong></div>
            </div>
        </section>
    }
}

@code {
    private AnalyticsSummaryModel? _analytics;
    private InsightSummaryModel? _insights;
    private SystemStatusModel? _status;
    private bool _healthOk;
    private IDisposable? _pollingHandle;
    private string? _error;
    private DateTime? _lastUpdatedUtc;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _pollingHandle = RefreshCoordinator.StartPolling(RefreshArea.Dashboard, async () =>
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _analytics = await ApiClient.GetAnalyticsAsync();
            _insights = await ApiClient.GetInsightsAsync();
            _status = await ApiClient.GetStatusAsync();
            _healthOk = await ApiClient.IsApiHealthyAsync();
            _lastUpdatedUtc = DateTime.UtcNow;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private static string StatusClass(bool ok) => ok ? "status-pill ok" : "status-pill bad";

    private string FocusFailedJobs() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"{Localizer.FormatNumber(_analytics?.FailedJobs ?? 0)} задач с ошибкой требуют внимания.",
        FarmLanguages.Uzbek => $"{Localizer.FormatNumber(_analytics?.FailedJobs ?? 0)} ta xatoli ish e'tibor talab qiladi.",
        _ => $"{Localizer.FormatNumber(_analytics?.FailedJobs ?? 0)} failed jobs need attention."
    };

    private string FocusStuckJobs() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"{Localizer.FormatNumber(_analytics?.StuckJobs ?? 0)} зависших задач ждут вмешательства.",
        FarmLanguages.Uzbek => $"{Localizer.FormatNumber(_analytics?.StuckJobs ?? 0)} ta stuck job aralashuvni kutmoqda.",
        _ => $"{Localizer.FormatNumber(_analytics?.StuckJobs ?? 0)} stuck jobs are waiting for intervention."
    };

    private string FocusDuplicateDeliveries() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"Зафиксировано {Localizer.FormatNumber(_analytics?.DuplicateDeliveries ?? 0)} дубликатов webhook-доставок.",
        FarmLanguages.Uzbek => $"{Localizer.FormatNumber(_analytics?.DuplicateDeliveries ?? 0)} ta duplicate webhook delivery qayd etilgan.",
        _ => $"{Localizer.FormatNumber(_analytics?.DuplicateDeliveries ?? 0)} duplicate webhook deliveries were recorded."
    };

    private string FocusFallbacks() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"В {Localizer.FormatNumber(_analytics?.OpenAiFallbacks ?? 0)} advisory использовался резервный анализ вместо OpenAI.",
        FarmLanguages.Uzbek => $"{Localizer.FormatNumber(_analytics?.OpenAiFallbacks ?? 0)} ta advisory OpenAI o'rniga fallback tahlildan foydalangan.",
        _ => $"{Localizer.FormatNumber(_analytics?.OpenAiFallbacks ?? 0)} advisories used fallback analysis instead of OpenAI."
    };

    public void Dispose() => _pollingHandle?.Dispose();
}
