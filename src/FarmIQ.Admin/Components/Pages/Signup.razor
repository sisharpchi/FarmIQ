@page "/signup"
@attribute [PublicPage]
@layout EmptyLayout
@inject IAuthService AuthService
@inject FarmAuthStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject AdminLocalizer Localizer

<PageTitle>@(Localizer["Create account"] + " | FarmIQ Admin")</PageTitle>

<div class="login-shell">
    <div class="login-panel">
        <div class="login-kicker">@Localizer["FarmIQ Admin"]</div>
        <h1>@(PublicSignupEnabled ? Localizer["Create your operations account"] : Localizer["Invite-only access is active"])</h1>
        <p class="login-copy">
            @(PublicSignupEnabled
                ? Localizer["Set up a FarmIQ admin account for analytics review, advisory quality checks, and daily operations."]
                : Localizer["Public signup is disabled in this environment. Ask an existing admin to create your account from the Users area."])
        </p>

        @if (PublicSignupEnabled)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSignupAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-field">
                    <label>@Localizer["Display name"]</label>
                    <InputText class="form-control" @bind-Value="_model.DisplayName" />
                </div>

                <div class="form-field">
                    <label>@Localizer["Email"]</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                </div>

                <div class="form-field">
                    <label>@Localizer["Password"]</label>
                    <InputText class="form-control" type="password" @bind-Value="_model.Password" />
                </div>

                <div class="form-field">
                    <label>@Localizer["Confirm password"]</label>
                    <InputText class="form-control" type="password" @bind-Value="_model.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <button class="btn btn-success login-button" type="submit" disabled="@_isSubmitting">
                    @(_isSubmitting ? Localizer["Creating account..."] : Localizer["Create account"])
                </button>
            </EditForm>
        }
        else
        {
            <div class="alert alert-warning">@Localizer["This deployment accepts new users through the internal Admin Users screen only."]</div>
        }

        <div class="auth-switch-copy">
            @Localizer["Already have an account?"]
            <a href="/login">@Localizer["Sign in"]</a>
        </div>
    </div>
</div>

@code {
    private readonly SignupRequestModel _model = new();
    private string? _error;
    private bool _isSubmitting;
    private bool _redirected;

    private bool PublicSignupEnabled => Configuration.GetValue<bool>("Auth:EnablePublicSignup");

    protected override void OnAfterRender(bool firstRender)
    {
        if (_redirected || !AuthStateProvider.IsInitialized || AuthStateProvider.CurrentSession is null)
        {
            return;
        }

        _redirected = true;
        Navigation.NavigateTo("/dashboard", replace: true);
    }

    private async Task HandleSignupAsync()
    {
        if (!PublicSignupEnabled)
        {
            _error = Localizer["Public signup is disabled in this environment. Ask an existing admin to create your account from the Users area."];
            return;
        }

        _isSubmitting = true;
        _error = null;
        var result = await AuthService.SignupAsync(_model);
        _isSubmitting = false;

        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        Navigation.NavigateTo("/dashboard", replace: true);
    }
}
