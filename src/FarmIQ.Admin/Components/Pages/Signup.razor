@page "/signup"
@attribute [PublicPage]
@layout EmptyLayout
@inject IAuthService AuthService
@inject FarmAuthStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>Sign Up | FarmIQ Admin</PageTitle>

<div class="login-shell">
    <div class="login-panel">
        <div class="login-kicker">FarmIQ Admin</div>
        <h1>@(PublicSignupEnabled ? "Create your operations account" : "Invite-only access is active")</h1>
        <p class="login-copy">
            @(PublicSignupEnabled
                ? "Set up a FarmIQ admin account for analytics review, advisory quality checks, and daily operations."
                : "Public signup is disabled in this environment. Ask an existing admin to create your account from the Users area.")
        </p>

        @if (PublicSignupEnabled)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSignupAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-field">
                    <label>Display name</label>
                    <InputText class="form-control" @bind-Value="_model.DisplayName" />
                </div>

                <div class="form-field">
                    <label>Email</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                </div>

                <div class="form-field">
                    <label>Password</label>
                    <InputText class="form-control" type="password" @bind-Value="_model.Password" />
                </div>

                <div class="form-field">
                    <label>Confirm password</label>
                    <InputText class="form-control" type="password" @bind-Value="_model.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <button class="btn btn-success login-button" type="submit" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Creating account..." : "Create account")
                </button>
            </EditForm>
        }
        else
        {
            <div class="alert alert-warning">This deployment accepts new users through the internal Admin Users screen only.</div>
        }

        <div class="auth-switch-copy">
            Already have an account?
            <a href="/login">Sign in</a>
        </div>
    </div>
</div>

@code {
    private readonly SignupRequestModel _model = new();
    private string? _error;
    private bool _isSubmitting;
    private bool _redirected;

    private bool PublicSignupEnabled => Configuration.GetValue<bool>("Features:EnablePublicSignup");

    protected override void OnAfterRender(bool firstRender)
    {
        if (_redirected || !AuthStateProvider.IsInitialized || AuthStateProvider.CurrentSession is null)
        {
            return;
        }

        _redirected = true;
        Navigation.NavigateTo("/dashboard", replace: true);
    }

    private async Task HandleSignupAsync()
    {
        if (!PublicSignupEnabled)
        {
            _error = "Public signup is disabled in this environment.";
            return;
        }

        _isSubmitting = true;
        _error = null;
        var result = await AuthService.SignupAsync(_model);
        _isSubmitting = false;

        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        Navigation.NavigateTo("/dashboard", replace: true);
    }
}
