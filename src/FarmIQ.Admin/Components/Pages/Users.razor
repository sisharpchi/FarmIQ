@page "/users"
@attribute [RouteAccess("Admin")]
@inject FarmAdminApiClient ApiClient
@inject AdminLocalizer Localizer

<PageTitle>@(Localizer["Users"] + " | FarmIQ Admin")</PageTitle>

<h1>@Localizer["Users"]</h1>

<div class="page-grid">
    <section class="panel-card">
        <h2>@Localizer["Create account"]</h2>

        <EditForm Model="_createModel" OnValidSubmit="CreateUserAsync">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label>@Localizer["Display name"]</label>
                <InputText class="form-control" @bind-Value="_createModel.DisplayName" />
            </div>

            <div class="form-field">
                <label>@Localizer["Email"]</label>
                <InputText class="form-control" @bind-Value="_createModel.Email" />
            </div>

            <div class="form-field">
                <label>@Localizer["Initial password"]</label>
                <InputText class="form-control" type="password" @bind-Value="_createModel.Password" />
            </div>

            <div class="form-field">
                <label>@Localizer["Roles"]</label>
                <div class="role-grid">
                    @foreach (var role in _createRoleToggles)
                    {
                        <label class="role-pill">
                            <input type="checkbox" @bind="role.IsSelected" />
                            <span>@Localizer.Role(role.Name)</span>
                        </label>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_createMessage))
            {
                <div class="@AlertClass(_createSucceeded)">@_createMessage</div>
            }

            <button class="btn btn-success" type="submit" disabled="@_submittingCreate">
                @(_submittingCreate ? Localizer["Creating..."] : Localizer["Create user"])
            </button>
        </EditForm>

        <hr />

        <div class="table-tools">
            <button class="btn btn-outline-success" @onclick="LoadAsync">@Localizer["Refresh"]</button>
        </div>

        <DataState IsLoading="@_isLoading" IsEmpty="@(_users is not null && _users.Items.Count == 0)" Error="@_error" LoadingText="@(Localizer["Loading admin users..."])" EmptyText="@(Localizer["No admin users were found."])" />

        @if (_users is not null && string.IsNullOrWhiteSpace(_error))
        {
            <table class="table table-darkless">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Email"]</th>
                        <th>@Localizer["Roles"]</th>
                        <th>@Localizer["Status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users.Items)
                    {
                        <tr class="@(IsSelected(user) ? "table-active" : null)">
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>@string.Join(", ", user.Roles.Select(Localizer.Role))</td>
                            <td>@CurrentStatusText(user.IsEnabled)</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SelectUser(user)">@Localizer["Manage"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <PaginationBar Page="@_page" PageSize="@_pageSize" TotalCount="@_users.TotalCount" OnPageChanged="HandlePageChangedAsync" />
        }
    </section>

    <section class="panel-card">
        <h2>@Localizer["User controls"]</h2>

        @if (_selectedUser is null)
        {
            <p>@SelectUserText()</p>
        }
        else
        {
            <div class="detail-meta">
                <strong>@_selectedUser.DisplayName</strong>
                <span>@CurrentStatusText(_selectedUser.IsEnabled)</span>
            </div>

            <p class="subtle-copy user-detail-copy">@_selectedUser.Email</p>

            <div class="form-field">
                <label>@Localizer["Roles"]</label>
                <div class="role-grid">
                    @foreach (var role in _selectedRoleToggles)
                    {
                        <label class="role-pill">
                            <input type="checkbox" @bind="role.IsSelected" />
                            <span>@Localizer.Role(role.Name)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="action-row">
                <button class="btn btn-outline-success" @onclick="SaveRolesAsync" disabled="@_workingSelectedUser">@Localizer["Save roles"]</button>
                @if (_selectedUser.IsEnabled)
                {
                    <button class="btn btn-outline-danger" @onclick="DisableSelectedUserAsync" disabled="@_workingSelectedUser">@Localizer["Disable access"]</button>
                }
                else
                {
                    <button class="btn btn-success" @onclick="EnableSelectedUserAsync" disabled="@_workingSelectedUser">@Localizer["Enable access"]</button>
                }
            </div>

            <div class="form-field">
                <label>@Localizer["Reset password"]</label>
                <InputText class="form-control" type="password" @bind-Value="_resetPassword" />
            </div>

            <button class="btn btn-outline-success" @onclick="ResetPasswordAsync" disabled="@_workingSelectedUser">
                @Localizer["Apply new password"]
            </button>

            @if (!string.IsNullOrWhiteSpace(_selectedMessage))
            {
                <div class="@AlertClass(_selectedSucceeded)">@_selectedMessage</div>
            }

            <ul class="signal-list user-meta-list">
                <li>@UserMetaLine("Failed sign-in attempts", _selectedUser.AccessFailedCount.ToString())</li>
                <li>@UserMetaLine("Lockout end", _selectedUser.LockoutEndUtc.HasValue ? Localizer.FormatDateTime(_selectedUser.LockoutEndUtc.Value.ToLocalTime()) : NotLockedText())</li>
            </ul>
        }
    </section>
</div>

@code {
    private static readonly string[] AvailableRoles = ["Admin", "Ops", "Analyst"];

    private readonly AdminUserCreateModel _createModel = new();
    private readonly List<RoleToggle> _createRoleToggles = AvailableRoles.Select(role => new RoleToggle(role, role == "Analyst")).ToList();
    private readonly List<RoleToggle> _selectedRoleToggles = AvailableRoles.Select(role => new RoleToggle(role)).ToList();

    private PagedResponseModel<AdminUserSummaryModel>? _users;
    private AdminUserSummaryModel? _selectedUser;
    private string? _error;
    private string? _createMessage;
    private string? _selectedMessage;
    private string _resetPassword = string.Empty;
    private bool _createSucceeded;
    private bool _selectedSucceeded;
    private bool _isLoading = true;
    private bool _submittingCreate;
    private bool _workingSelectedUser;
    private int _page = 1;
    private const int _pageSize = 12;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _error = null;
            _users = await ApiClient.GetUsersAsync(_page, _pageSize);

            if (_selectedUser is not null)
            {
                var refreshedSelection = _users.Items.FirstOrDefault(user => user.UserId == _selectedUser.UserId);
                if (refreshedSelection is not null)
                {
                    SelectUser(refreshedSelection);
                }
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateUserAsync()
    {
        _submittingCreate = true;
        _createMessage = null;

        _createModel.Roles = SelectedRoles(_createRoleToggles);
        if (_createModel.Roles.Count == 0)
        {
            _createSucceeded = false;
            _createMessage = SelectRoleForNewUserText();
            _submittingCreate = false;
            return;
        }

        var result = await ApiClient.CreateUserAsync(_createModel);
        _createSucceeded = result.Success;
        _createMessage = result.Success ? UserCreatedText() : result.ErrorMessage;

        if (result.Success)
        {
            _createModel.DisplayName = string.Empty;
            _createModel.Email = string.Empty;
            _createModel.Password = string.Empty;
            ResetRoleSelection(_createRoleToggles, "Analyst");
            await LoadAsync();
        }

        _submittingCreate = false;
    }

    private void SelectUser(AdminUserSummaryModel user)
    {
        _selectedUser = user;
        _selectedMessage = null;
        _selectedSucceeded = false;
        _resetPassword = string.Empty;

        foreach (var role in _selectedRoleToggles)
        {
            role.IsSelected = user.Roles.Contains(role.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task SaveRolesAsync()
    {
        if (_selectedUser is null)
        {
            return;
        }

        var roles = SelectedRoles(_selectedRoleToggles);
        if (roles.Count == 0)
        {
            _selectedSucceeded = false;
            _selectedMessage = SelectRoleBeforeSavingText();
            return;
        }

        _workingSelectedUser = true;
        var result = await ApiClient.UpdateUserRolesAsync(_selectedUser.UserId, roles);
        _selectedSucceeded = result.Success;
        _selectedMessage = result.Success ? UserRolesUpdatedText() : result.ErrorMessage;

        if (result.Success)
        {
            await LoadAsync();
        }

        _workingSelectedUser = false;
    }

    private async Task DisableSelectedUserAsync()
    {
        if (_selectedUser is null)
        {
            return;
        }

        _workingSelectedUser = true;
        var result = await ApiClient.DisableUserAsync(_selectedUser.UserId);
        _selectedSucceeded = result.Success;
        _selectedMessage = result.Success ? UserDisabledText() : result.ErrorMessage;

        if (result.Success)
        {
            await LoadAsync();
        }

        _workingSelectedUser = false;
    }

    private async Task EnableSelectedUserAsync()
    {
        if (_selectedUser is null)
        {
            return;
        }

        _workingSelectedUser = true;
        var result = await ApiClient.EnableUserAsync(_selectedUser.UserId);
        _selectedSucceeded = result.Success;
        _selectedMessage = result.Success ? UserEnabledText() : result.ErrorMessage;

        if (result.Success)
        {
            await LoadAsync();
        }

        _workingSelectedUser = false;
    }

    private async Task ResetPasswordAsync()
    {
        if (_selectedUser is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_resetPassword))
        {
            _selectedSucceeded = false;
            _selectedMessage = EnterReplacementPasswordText();
            return;
        }

        _workingSelectedUser = true;
        var result = await ApiClient.ResetPasswordAsync(_selectedUser.UserId, _resetPassword);
        _selectedSucceeded = result.Success;
        _selectedMessage = result.Success ? PasswordResetText() : result.ErrorMessage;

        if (result.Success)
        {
            _resetPassword = string.Empty;
            await LoadAsync();
        }

        _workingSelectedUser = false;
    }

    private async Task HandlePageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private bool IsSelected(AdminUserSummaryModel user) => _selectedUser?.UserId == user.UserId;

    private static IReadOnlyCollection<string> SelectedRoles(IEnumerable<RoleToggle> toggles) =>
        toggles.Where(role => role.IsSelected).Select(role => role.Name).ToArray();

    private static void ResetRoleSelection(IEnumerable<RoleToggle> toggles, string defaultRole)
    {
        foreach (var role in toggles)
        {
            role.IsSelected = string.Equals(role.Name, defaultRole, StringComparison.OrdinalIgnoreCase);
        }
    }

    private string SelectUserText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Выберите пользователя, чтобы изменить роли, отключить доступ или выдать новый пароль.",
        FarmLanguages.Uzbek => "Rollarni o'zgartirish, kirishni o'chirish yoki yangi parol berish uchun foydalanuvchini tanlang.",
        _ => "Select a user to adjust roles, disable access, or issue a new password."
    };

    private string SelectRoleForNewUserText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Выберите хотя бы одну роль для нового аккаунта.",
        FarmLanguages.Uzbek => "Yangi hisob uchun kamida bitta rol tanlang.",
        _ => "Select at least one role for the new account."
    };

    private string UserCreatedText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Аккаунт пользователя успешно создан.",
        FarmLanguages.Uzbek => "Foydalanuvchi hisobi muvaffaqiyatli yaratildi.",
        _ => "User account created successfully."
    };

    private string SelectRoleBeforeSavingText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Перед сохранением выберите хотя бы одну роль.",
        FarmLanguages.Uzbek => "Saqlashdan oldin kamida bitta rol tanlang.",
        _ => "Select at least one role before saving."
    };

    private string UserRolesUpdatedText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Роли пользователя обновлены.",
        FarmLanguages.Uzbek => "Foydalanuvchi rollari yangilandi.",
        _ => "User roles updated."
    };

    private string UserDisabledText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Доступ пользователя отключён.",
        FarmLanguages.Uzbek => "Foydalanuvchi kirishi o'chirildi.",
        _ => "User access disabled."
    };

    private string UserEnabledText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Доступ пользователя восстановлен.",
        FarmLanguages.Uzbek => "Foydalanuvchi kirishi qayta yoqildi.",
        _ => "User access restored."
    };

    private string EnterReplacementPasswordText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Введите новый пароль перед сбросом.",
        FarmLanguages.Uzbek => "Reset qilishdan oldin yangi parolni kiriting.",
        _ => "Enter the replacement password before resetting."
    };

    private string PasswordResetText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Пароль успешно сброшен.",
        FarmLanguages.Uzbek => "Parol muvaffaqiyatli yangilandi.",
        _ => "Password reset applied successfully."
    };

    private string UserMetaLine(string label, string value) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => label switch
        {
            "Failed sign-in attempts" => $"Неудачные попытки входа: {value}",
            "Lockout end" => $"Блокировка до: {value}",
            _ => $"{label}: {value}"
        },
        FarmLanguages.Uzbek => label switch
        {
            "Failed sign-in attempts" => $"Muvaffaqiyatsiz kirishlar: {value}",
            "Lockout end" => $"Lockout tugashi: {value}",
            _ => $"{label}: {value}"
        },
        _ => $"{label}: {value}"
    };

    private string NotLockedText() => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => "Не заблокирован",
        FarmLanguages.Uzbek => "Lock qilinmagan",
        _ => "Not locked"
    };

    private string CurrentStatusText(bool enabled) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => enabled ? "Включён" : "Отключён",
        FarmLanguages.Uzbek => enabled ? "Yoqilgan" : "O'chirilgan",
        _ => enabled ? "Enabled" : "Disabled"
    };

    private static string AlertClass(bool success) => success ? "alert alert-success" : "alert alert-danger";

    private sealed class RoleToggle(string name, bool isSelected = false)
    {
        public string Name { get; } = name;
        public bool IsSelected { get; set; } = isSelected;
    }
}
