@page "/login"
@attribute [PublicPage]
@layout EmptyLayout
@inject IAuthService AuthService
@inject FarmAuthStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject AdminLocalizer Localizer

<PageTitle>@(Localizer["Login"] + " | FarmIQ Admin")</PageTitle>

<div class="login-shell">
    <div class="login-panel">
        <div class="login-kicker">@Localizer["FarmIQ Admin"]</div>
        <h1>@Localizer["Sign in to the field operations console"]</h1>
        <p class="login-copy">@Localizer["Monitor farmer conversations, troubleshoot delivery issues, and recover advisory jobs from one place."]</p>

        <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label>@Localizer["Email"]</label>
                <InputText class="form-control" @bind-Value="_model.Email" />
            </div>

            <div class="form-field">
                <label>@Localizer["Password"]</label>
                <InputText class="form-control" type="password" @bind-Value="_model.Password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <button class="btn btn-success login-button" type="submit" disabled="@_isSubmitting">
                @(_isSubmitting ? Localizer["Signing in..."] : Localizer["Sign in"])
            </button>
        </EditForm>

        @if (PublicSignupEnabled)
        {
            <div class="auth-switch-copy">
                @Localizer["Need an account?"]
                <a href="/signup">@Localizer["Create one here"]</a>
            </div>
        }
        else
        {
            <div class="auth-switch-copy">
                @Localizer["Invite-only access is enabled. Ask an existing admin to provision your account."]
            </div>
        }
    </div>
</div>

@code {
    private readonly LoginRequestModel _model = new();
    private string? _error;
    private bool _isSubmitting;
    private bool _redirected;

    private bool PublicSignupEnabled => Configuration.GetValue<bool>("Auth:EnablePublicSignup");

    protected override void OnAfterRender(bool firstRender)
    {
        if (_redirected || !AuthStateProvider.IsInitialized || AuthStateProvider.CurrentSession is null)
        {
            return;
        }

        _redirected = true;
        Navigation.NavigateTo("/dashboard", replace: true);
    }

    private async Task HandleLoginAsync()
    {
        _isSubmitting = true;
        _error = null;
        var result = await AuthService.LoginAsync(_model);
        _isSubmitting = false;

        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        Navigation.NavigateTo("/dashboard", replace: true);
    }
}
