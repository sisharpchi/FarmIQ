@page "/jobs"
@attribute [RouteAccess("Admin", "Ops")]
@implements IDisposable
@inject FarmAdminApiClient ApiClient
@inject RefreshCoordinator RefreshCoordinator
@inject AdminLocalizer Localizer

<PageTitle>@(Localizer["Jobs"] + " | FarmIQ Admin")</PageTitle>

<h1>@Localizer["Jobs"]</h1>

<div class="page-grid">
    <section class="panel-card">
        <div class="table-tools">
            <select class="form-select narrow-select" @bind="_selectedStatus">
                <option value="">@Localizer["All"]</option>
                @foreach (var status in Enum.GetValues<ProcessingJobStatus>())
                {
                    <option value="@status">@Localizer.JobStatus(status)</option>
                }
            </select>
            <button class="btn btn-outline-success" @onclick="LoadAsync">@Localizer["Apply"]</button>
        </div>

        <DataState IsLoading="@_isLoading" IsEmpty="@(_jobs is not null && _jobs.Items.Count == 0)" Error="@_error" LoadingText="@(Localizer["Loading jobs..."])" EmptyText="@(Localizer["No jobs matched this filter."])" />

        @if (_jobs is not null && string.IsNullOrWhiteSpace(_error))
        {
            <table class="table table-darkless">
                <thead>
                    <tr>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Attempts"]</th>
                        <th>@Localizer["Scheduled"]</th>
                        <th>@Localizer["Next attempt"]</th>
                        <th>@Localizer["Error"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in _jobs.Items)
                    {
                        <tr>
                            <td>@Localizer.JobStatus(job.Status)</td>
                            <td>@job.Attempts</td>
                            <td>@Localizer.FormatDateTime(job.ScheduledUtc.ToLocalTime())</td>
                            <td>@(job.NextAttemptUtc.HasValue ? Localizer.FormatDateTime(job.NextAttemptUtc.Value.ToLocalTime()) : Localizer["Not available"])</td>
                            <td>@job.LastError</td>
                            <td>
                                @if (job.Status == ProcessingJobStatus.Failed || job.Status == ProcessingJobStatus.Retrying)
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => RetryAsync(job.JobId)">@Localizer["Retry"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <PaginationBar Page="@_page" PageSize="@_pageSize" TotalCount="@_jobs.TotalCount" OnPageChanged="HandlePageChangedAsync" />
        }
    </section>

    <section class="panel-card">
        <h2>@Localizer["Stuck jobs"]</h2>
        @if (_stuckJobs is null)
        {
            <p>@Localizer["Loading stuck jobs..."]</p>
        }
        else if (_stuckJobs.Items.Count == 0)
        {
            <p>@Localizer["No stuck jobs right now."]</p>
        }
        else
        {
            <ul class="signal-list">
                @foreach (var job in _stuckJobs.Items)
                {
                    <li>@StuckJobLabel(job)</li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private PagedResponseModel<ProcessingJobSummaryModel>? _jobs;
    private PagedResponseModel<StuckJobSummaryModel>? _stuckJobs;
    private IDisposable? _pollingHandle;
    private ProcessingJobStatus? _selectedStatus;
    private string? _error;
    private bool _isLoading = true;
    private int _page = 1;
    private const int _pageSize = 12;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _pollingHandle = RefreshCoordinator.StartPolling(RefreshArea.Jobs, async () =>
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _error = null;
            _jobs = await ApiClient.GetJobsAsync(_selectedStatus, _page, _pageSize);
            _stuckJobs = await ApiClient.GetStuckJobsAsync(1, 12);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RetryAsync(Guid jobId)
    {
        await ApiClient.RetryJobAsync(jobId);
        await LoadAsync();
    }

    private async Task HandlePageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private string StuckJobLabel(StuckJobSummaryModel job) => Localizer.CurrentLanguage switch
    {
        FarmLanguages.Russian => $"{job.JobId} | lease {Localizer.FormatNullableDateTime(job.LeaseExpiresUtc?.ToLocalTime())} | попыток {job.Attempts} | ошибка {job.LastError}",
        FarmLanguages.Uzbek => $"{job.JobId} | lease {Localizer.FormatNullableDateTime(job.LeaseExpiresUtc?.ToLocalTime())} | urinishlar {job.Attempts} | xato {job.LastError}",
        _ => $"{job.JobId} | lease {Localizer.FormatNullableDateTime(job.LeaseExpiresUtc?.ToLocalTime())} | attempts {job.Attempts} | error {job.LastError}"
    };

    public void Dispose() => _pollingHandle?.Dispose();
}
